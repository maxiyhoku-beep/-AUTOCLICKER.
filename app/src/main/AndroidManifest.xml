<manifest xmlns:android="[schemas.android.com](http://schemas.android.com/apk/res/android)">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="𝑹𝑨𝑺// AUTO CLICK"
        android:icon="@drawable/logo"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".ClickService" android:exported="true"
            android:label="𝑹𝑨𝑺// AUTO CLICK"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/acc"/>
        </service>
    </application>
</manifest>
